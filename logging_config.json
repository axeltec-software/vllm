{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "format": "%(levelname)s:%(name)s:%(message)s"
    }
  },
  "handlers": {
    "console": {
      "level": "INFO",
      "formatter": "standard",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "level": "DEBUG",
      "formatter": "standard",
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "vllm.log",
      "maxBytes": 10485760,
      "backupCount": 5
    }
  },
  "loggers": {
    "vllm": {
      "handlers": ["console", "file"],
      "level": "DEBUG",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["console"],
    "level": "INFO"
  }
}
